# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# API (apps/api)
GEMINI_API_KEY=            # server only. Never put this in the web or desktop app.
GEMINI_MODEL=              # chosen model. Check its current free-tier limits.
GEMINI_EMBEDDING_MODEL=    # or use a local embedding model
SIMILARITY_THRESHOLD=0.55  # tune on data/eval. Depends on the embedding model.
TOP_K=3
MIN_STEPS=3
MAX_STEPS=8
MAX_WORDS_PER_STEP=20
SESSION_TTL_HOURS=168
SESSION_CALL_LIMIT=40      # LLM calls per session
DAILY_CALL_LIMIT=500       # protect the free-tier quota
ALLOWED_ORIGINS=http://localhost:3000,app://startease
REDIS_URL=                 # optional. In-memory store is fine for the prototype.
LOG_LEVEL=info             # never log task text

# Web (apps/web)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_API_URL=http://localhost:8000

