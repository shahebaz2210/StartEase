{
  "name": "StartEase Design Tokens",
  "version": "1.0.0",
  "colors": {
    "background": {
      "page": "#EBF5EE",
      "card": "#FFFFFF",
      "cardSubtle": "#F7FAF8",
      "sageLight": "#EFF7F1",
      "sageMedium": "#E2EFE6",
      "sagePill": "#E1F0E6",
      "sageBorder": "#D3E4D8"
    },
    "text": {
      "primary": "#1A3323",
      "secondary": "#4A5D50",
      "muted": "#718779",
      "inverse": "#FFFFFF",
      "accent": "#2D5A3D"
    },
    "brand": {
      "primary": "#2D5A3D",
      "primaryHover": "#244931",
      "secondary": "#E2EFE6",
      "secondaryHover": "#D5E7DB",
      "accent": "#52B788",
      "guestButton": "#B7E4C7",
      "guestButtonHover": "#A3D9B5"
    },
    "state": {
      "success": "#2D5A3D",
      "warning": "#D97706",
      "danger": "#DC2626",
      "crisisBackground": "#FEF2F2",
      "crisisBorder": "#FECACA",
      "crisisText": "#991B1B"
    }
  },
  "typography": {
    "fontFamily": {
      "serif": "'Newsreader', 'Playfair Display', Georgia, serif",
      "sans": "'Plus Jakarta Sans', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem"
    },
    "fontWeight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "spacing": {
    "cardPadding": "2.5rem",
    "cardRadius": "1.5rem",
    "buttonRadius": "0.75rem",
    "pillRadius": "9999px"
  },
  "shadows": {
    "card": "0 10px 30px -5px rgba(27, 67, 50, 0.05), 0 4px 10px -2px rgba(27, 67, 50, 0.02)",
    "floating": "0 20px 40px -10px rgba(27, 67, 50, 0.15), 0 0 1px 1px rgba(27, 67, 50, 0.05)"
  }
}
